# ==============================================================
# ERP DIMSUM - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================
# INSTRUKSI:
# 1. Di server, copy file ini jadi .env (rename)
# 2. Isi nilai-nilai yang bertanda [ISI_INI] dengan data asli
# 3. JANGAN commit file .env asli ke Git!
# ==============================================================

# ------ APP CONFIG ------
APP_NAME="ERP Dmentai"
APP_ENV=production
APP_KEY=[ISI_INI_APP_KEY]
APP_DEBUG=false
APP_URL=https://erpdimsum.azwacore.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ------ LOG CONFIG ------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------ DATABASE CONFIG (WAJIB DIUBAH!) ------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=azwc7142_erp_dimsum
DB_USERNAME=azwc7142_erp_user
DB_PASSWORD=[ISI_INI_PASSWORD_DB]

# ------ SESSION CONFIG ------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ------ CACHE CONFIG ------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ------ REDIS (Not used) ------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------ MAIL CONFIG (Opsional, kalau butuh kirim email) ------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@erpdimsum.azwacore.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------ AWS S3 (Not used, biarkan default) ------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------ VITE CONFIG ------
VITE_APP_NAME="${APP_NAME}"

# ------ PUSHER (Notifikasi Real-time - Opsional) ------
# Kalau tidak pakai notifikasi push, biarkan kosong
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ------ TIMEZONE ------
APP_TIMEZONE=Asia/Jakarta

# ==============================================================
# PENTING - CHECKLIST SEBELUM APLIKASI LIVE:
# ==============================================================
# [ ] APP_KEY sudah di-generate (via web installer atau manual)
# [ ] DB credentials sudah diisi benar
# [ ] APP_URL sudah pakai https:// (bukan http)
# [ ] APP_DEBUG=false (WAJIB, jangan true di production!)
# [ ] APP_ENV=production
# [ ] Test buka https://erpdimsum.azwacore.com/login
# ==============================================================
